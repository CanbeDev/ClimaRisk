DATABASE_URL=postgresql://climrisk_app:changeme@localhost:5432/ClimRisk
GDACS_BASE_URL=https://www.gdacs.org/gdacsapi/api
GDACS_COUNTRY_FILTER=ZAF
GDACS_EVENT_TYPES=EQ;TC;FL;VO;WF;DR
GDACS_POLL_INTERVAL_HOURS=2
GDACS_POLYGON_INTERVAL_HOURS=6
GDACS_REQUEST_DELAY_SECONDS=0.5
GDACS_REQUEST_TIMEOUT_SECONDS=30.0
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Parametric trigger engine (Phase 2). When the scheduler is on, active rules are
# re-evaluated against every stored event every PARAMETRIC_INTERVAL_HOURS.
PARAMETRIC_AUTO_EVALUATE=true
PARAMETRIC_INTERVAL_HOURS=6

# Optional: when set, /ingest/* and /parametric/* write + evaluate routes require a
# matching X-API-Key header. Leave unset for local/dev use; set before exposing this
# service outside a trusted network.
INGEST_API_KEY=
